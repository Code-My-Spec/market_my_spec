# Kamal reads this as a Dotenv file — values like ${VAR} are interpolated
# from the environment of the kamal process.
#
# Registry creds point at cms-registry (self-hosted, per-project, colocated
# on each box) rather than ghcr.io — CodeMySpec's harness delivers
# KAMAL_REGISTRY_USERNAME/KAMAL_REGISTRY_PASSWORD itself before invoking
# bin/deploy, so no manual `gh auth token` step is needed for that path.
#
# SOPS_AGE_KEY has to be here too: bin/deploy's migrate() passes it along
# explicitly (kamal app exec -e SOPS_AGE_KEY:...), but swap() just calls
# `kamal deploy`, which only forwards secrets it knows about from this
# file's env: secret: list — SOPS_AGE_KEY needs to reach the *running*
# container (bin/boot decrypts envs/<env>.enc.env with it), not just
# migrate's ephemeral one. Same delivery mechanism as the registry creds,
# from the harness for CMS-managed runs, exported by hand otherwise.
#
# AWS_ACCESS_KEY_ID/SECRET stay for scripts/deploy's old SSM-bootstrap
# path; the sops-managed path doesn't need them (already inside
# envs/<env>.enc.env) but passing them again is harmless.

KAMAL_REGISTRY_USERNAME=${KAMAL_REGISTRY_USERNAME}
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD}
SOPS_AGE_KEY=${SOPS_AGE_KEY}
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
