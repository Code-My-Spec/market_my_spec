# Kamal reads this as a Dotenv file — values like ${VAR} are interpolated
# from the environment of the kamal process.
#
# Registry creds point at cms-registry (self-hosted, per-project, colocated
# on each box) rather than ghcr.io — CodeMySpec's harness delivers
# KAMAL_REGISTRY_USERNAME/KAMAL_REGISTRY_PASSWORD itself before invoking
# bin/deploy, so no manual `gh auth token` step is needed for that path.
# A human running scripts/deploy/scripts/deploy-uat still needs AWS bootstrap
# creds exported first, same as before.
#
# This file is the SHORT list — Kamal carries only AWS bootstrap creds
# (so MarketMySpec.Secrets.load!/1 inside the container can fetch the
# rest from SSM at boot) plus the registry credential for image pulls. App
# secrets are NEVER passed through here. See lib/market_my_spec/secrets.ex.

KAMAL_REGISTRY_USERNAME=${KAMAL_REGISTRY_USERNAME}
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD}
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
